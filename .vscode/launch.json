{
    "version": "0.2.0",
    "configurations": [
      {
        "name": "hw3 dqn mspacman",
        "type": "debugpy",
        "request": "launch",
        "module": "cs285.scripts.run_hw3_dqn",
        "args": [
          "-cfg", "experiments/dqn/mspacman.yaml",
          "--seed", "1"
        ],
        "console": "integratedTerminal",
        "cwd": "${workspaceFolder}/hw3",
        "env": {
          "PYTHONPATH": "${workspaceFolder}/hw3/cs285/scripts",
          "LD_LIBRARY_PATH": "/data/wmz5132/anaconda3/envs/cs285/lib:/data/wmz5132/anaconda3/envs/cs285/lib/python3.9/site-packages/torch/lib:/usr/lib/x86_64-linux-gnu"
        }
      },
      {
        "name": "hw1",
        "type": "debugpy",
        "request": "launch",
        "module": "cs285.scripts.run_hw1",
        "args": [
          "--expert_policy_file", "cs285/policies/experts/Ant.pkl",
          "--env_name", "Ant-v4",
          "--exp_name", "bc_ant",
          "--n_iter", "1",
          "--expert_data", "cs285/expert_data/expert_data_Ant-v4.pkl",
          "--video_log_freq", "-1"
        ],
        "console": "integratedTerminal",
        "cwd": "${workspaceFolder}/hw1"
      },
      {
        "name": "offline_rl: collect data (debug)",
        "type": "debugpy",
        "request": "launch",
        "module": "offline_rl.collect_data",
        "args": [
          "--n", "5000",
          "--expert-frac", "0.7",
          "--expert-noise", "0.5",
          "--seed", "0",
          "--out", "offline_rl/data/pendulum_debug.npz"
        ],
        "console": "integratedTerminal",
        "cwd": "${workspaceFolder}",
        "justMyCode": true
      },
      {
        "name": "offline_rl: train IQL (debug)",
        "type": "debugpy",
        "request": "launch",
        "module": "offline_rl.train_iql",
        "args": [
          "--data", "offline_rl/data/pendulum_debug.npz",
          "--steps", "2000",
          "--batch-size", "256",
          "--eval-every", "500",
          "--eval-episodes", "2",
          "--seed", "0",
          "--device", "cpu"
        ],
        "console": "integratedTerminal",
        "cwd": "${workspaceFolder}",
        "justMyCode": true
      },
      {
        "name": "offline_rl: train CQL (debug)",
        "type": "debugpy",
        "request": "launch",
        "module": "offline_rl.train_cql",
        "args": [
          "--data", "offline_rl/data/pendulum_debug.npz",
          "--steps", "2000",
          "--batch-size", "256",
          "--eval-every", "500",
          "--eval-episodes", "2",
          "--seed", "0",
          "--device", "cpu",
          "--cql-n-samples", "4"
        ],
        "console": "integratedTerminal",
        "cwd": "${workspaceFolder}",
        "justMyCode": true
      }
    ]
}